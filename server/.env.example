# ─── LeadBridge Server — Environment Variables ─────────────────
# Copy this file to .env before starting the server:
#   cp .env.example .env
#
# 🔴 = Required (server won't start without these)
# 🟢 = Optional (only needed for specific features)
# ────────────────────────────────────────────────────────────────

# ─── 🔴 REQUIRED ─────────────────────────────────────────────────
# JWT_SECRET — Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-64-char-random-string
JWT_REFRESH_SECRET=change-this-to-another-64-char-random-string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadbridge
DATABASE_URL_PRISMA=postgresql://postgres:postgres@localhost:5432/leadbridge
REDIS_URL=redis://:redispass@localhost:6379

# ─── 🟢 DEMO MODE — Run without external APIs (for investor demos) ─
# Set to true to skip OMNIDIM_API_KEY validation and use simulated providers.
# All AI calls, WhatsApp, SMS, and emails will be simulated locally.
# Login: demo@broker.com / demo123!A
DEMO_MODE=true

# ─── 🟢 REQUIRED only if DEMO_MODE=false ────────────────────────
OMNIDIM_API_KEY=get-from-omnidim-dashboard

# ─── 🟢 APP ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ─── 🟢 PROVIDER SELECTION ───────────────────────────────────────
# Phone provider: "twilio" | "omnidimension" (default)
PHONE_PROVIDER=omnidimension
# Voice AI provider: "omnidimension" (only option currently)
VOICE_AI_PROVIDER=omnidimension

# ─── 🔴 OMNIDIMENSION (Voice AI Agent Platform) ──────────────────
# Required for AI voice calls. Get API key from omnidimension.ai
OMNIDIM_API_KEY=your-omni-api-key
OMNIDIM_BASE_URL=https://backend.omnidim.io/api/v1

# ─── 🟢 TWILIO (Direct Phone Number Purchasing) ─────────────────
# Set PHONE_PROVIDER=twilio to buy numbers directly from Twilio
# instead of going through Omnidimension's dashboard.
# Get credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_URL=
TWILIO_SMS_URL=

# ─── 🟢 LLM / AI (OpenRouter) ───────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# ─── 🟢 WhatsApp Cloud API ───────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ─── 🟢 Razorpay (Payments) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=

# ─── 🟢 Supabase (File Storage) ─────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_RECORDINGS_BUCKET=call-recordings

# ─── 🟢 SMTP Email (Nodemailer) ─────────────────────────────────
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@leadbridge.com
FROM_NAME=LeadBridge

# ─── 🟢 Google OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── 🟢 MessageBird (SMS Fallback) ─────────────────────────────
MESSAGEBIRD_API_KEY=
SMS_SENDER_ID=LeadBrg

# ─── 🟢 Platform Cost Tracking ────────────────────────────────
# How much does the platform pay OmniDimension per minute of AI voice calls?
OMNIDIM_COST_PER_MINUTE=4.6
# Monthly rental cost per phone number (₹)
PHONE_NUMBER_MONTHLY_COST=200
# Average call duration in minutes (for cost estimation)
AVG_CALL_DURATION_MINUTES=2
# Low credit warning threshold (% of minutes remaining)
CREDIT_WARN_THRESHOLD_PERCENT=20

# ─── 🟢 SMS & Email Forwarding ────────────────────────────────
# The Twilio phone number that brokers forward portal SMS to
# Format: +919876543210 (E.164 with country code)
FORWARDING_SMS_NUMBER=
# The email address that brokers forward portal emails to
# For this to work automatically, set up SendGrid Inbound Parse or Mailgun Routes
# to POST parsed emails to: https://your-domain.com/api/v1/webhooks/email/incoming
FORWARDING_EMAIL=forward@leadbridge.com

# ─── 🟢 Security & Encryption ───────────────────────────────────
ENCRYPTION_KEY=
CRON_SECRET=change-me-cron-secret
