# ─── LeadBridge Frontend — Environment Variables ────────────────
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# All variables must be prefixed with NEXT_PUBLIC_ to be accessible
# in the browser.
# ───────────────────────────────────────────────────────────────

# 🔴 API URL — Fastify backend server
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# 🔴 App URL — Frontend domain
NEXT_PUBLIC_APP_URL=http://localhost:3001

# 🟢 WebSocket URL — Real-time updates
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# 🟢 Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ─── V2 marketing site (converza-v2) ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://converza.tech
NEXT_PUBLIC_API_URL=https://api.converza.tech
NEXT_PUBLIC_SUPPORT_EMAIL=support@converza.tech
# Competitor comparison page stays hidden until every claim is human-verified.
NEXT_PUBLIC_COMPARE_PAGE_ENABLED=false
# Early-access counters render only when the real value is at least this.
NEXT_PUBLIC_STATS_MIN_DISPLAY=1
# Refund answer appears only when the owner supplies the text.
NEXT_PUBLIC_POLICY_REFUND_TEXT=
# Trust block slots — hidden until provided.
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_PHOTO=
NEXT_PUBLIC_SAMPLE_CALL_AUDIO=
# T16 scope discipline: non-Pro-sold features stay off the marketing site.
NEXT_PUBLIC_FEATURE_CAMPAIGNS=false
NEXT_PUBLIC_FEATURE_AB_TESTS=false
NEXT_PUBLIC_FEATURE_WHITE_LABEL=false
